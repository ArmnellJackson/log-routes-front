---
/* Footer fijo — copyright izquierda, créditos centro, logo derecha */
---

<footer class="shrink-0 border-t border-white/10 bg-[#464d5a]/70 backdrop-blur-sm">
  <!-- Mobile: stack en 2 filas. Desktop: 3 columnas -->
  <div class="mx-auto w-full max-w-7xl px-6 md:px-12">

    <!-- Fila única desktop | 2 filas en mobile pequeño -->
    <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 py-3.5 sm:flex-nowrap sm:h-14 sm:py-0">

      <!-- Copyright — izquierda -->
      <p
        class="text-xs text-white/40 shrink-0 order-1"
        style="font-family: var(--font-sans);"
      >
        © {new Date().getFullYear()} LogicRoutes
      </p>

      <!-- Créditos — centro (orden 3 en mobile para que quede en segunda fila centrado) -->
      <a
        href="https://jackson-dev.vercel.app/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs text-white/50 hover:text-[#ff5e00] transition-colors duration-200 min-w-0 order-3 sm:order-2 w-full text-center sm:w-auto"
        style="font-family: var(--font-sans);"
        aria-label="Portafolio de Jackson-Dev — abre en nueva pestaña"
      >
        Creado por Jackson-Dev
      </a>

      <!-- Logo — derecha -->
      <a
        href="/"
        class="shrink-0 order-2 sm:order-3"
        aria-label="LogicRoutes — inicio"
      >
        <span
          class="text-xl tracking-widest text-white/75 hover:text-white transition-colors duration-200"
          style="font-family: var(--font-display);"
        >
          Log<span class="text-[#ff5e00]">Routes</span>
        </span>
      </a>

    </div>
  </div>
</footer>
