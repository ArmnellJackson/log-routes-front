---
/* Hero principal — pantalla completa sin scroll, tipografía centrada con animaciones */
---

<section class="relative flex-1 flex items-center justify-center overflow-hidden">

  <!-- Patrón de fondo: grid de rutas (red de nodos) -->
  <div class="absolute inset-0 opacity-[0.06]" aria-hidden="true">
    <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="route-grid" width="64" height="64" patternUnits="userSpaceOnUse">
          <path d="M 64 0 L 0 0 0 64" fill="none" stroke="white" stroke-width="0.75"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#route-grid)" />
    </svg>
  </div>

  <!-- Resplandor de acento naranja centrado (clamp para no desbordar en mobile) -->
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#ff5e00]/12 blur-[100px] pointer-events-none"
    style="width: clamp(280px, 70vw, 700px); height: clamp(200px, 50vw, 500px);"
    aria-hidden="true"
  />

  <!-- Destello secundario derecha (oculto en mobile para ahorrar render) -->
  <div
    class="hidden sm:block absolute top-0 right-0 w-96 h-96 rounded-full bg-[#ff5e00]/6 blur-[100px] pointer-events-none"
    aria-hidden="true"
  />

  <!-- Contenido centrado -->
  <div class="relative z-10 text-center px-6 max-w-5xl mx-auto w-full">

    <!-- Eyebrow -->
    <p
      class="hero-fade-up text-xs md:text-sm font-bold tracking-[0.35em] text-[#ff5e00] uppercase mb-5 md:mb-6"
      style="animation-delay: 0.1s;"
    >
      Plataforma de gestión de rutas
    </p>

    <!-- Título principal: Bebas Neue, fluid type -->
    <h1
      class="hero-fade-up text-white leading-none mb-6 md:mb-8"
      style="
        font-family: var(--font-display);
        font-size: clamp(4.5rem, 13vw, 11rem);
        letter-spacing: 0.04em;
        animation-delay: 0.25s;
      "
    >
      RUTAS<br />
      <span class="text-[#ff5e00]">LÓGICAS</span><br />
      SIN LÍMITES
    </h1>

    <!-- Subtítulo: Smooch Sans -->
    <p
      class="hero-fade-up text-base md:text-xl text-white/65 max-w-xl mx-auto mb-10 md:mb-12 leading-relaxed"
      style="font-family: var(--font-sans); animation-delay: 0.45s;"
    >
      Optimiza, planifica y gestiona tus rutas con inteligencia.
      Transforma la complejidad en claridad.
    </p>

    <!-- CTAs -->
    <div
      class="hero-fade-up flex flex-col sm:flex-row items-center justify-center gap-4"
      style="animation-delay: 0.65s;"
    >
      <!-- CTA primario -->
      <a
        href="#"
        class="inline-flex items-center justify-center h-12 px-8 rounded-lg bg-[#ff5e00] text-white font-bold text-sm tracking-wide hover:bg-[#e65400] active:bg-[#cc4a00] transition-colors duration-200 shadow-lg shadow-[#ff5e00]/20 w-full sm:w-auto"
        style="font-family: var(--font-sans);"
      >
        Comenzar gratis
      </a>

      <!-- CTA secundario -->
      <a
        href="#tutorial"
        class="inline-flex items-center justify-center h-12 px-8 rounded-lg border border-white/20 text-white/80 font-semibold text-sm tracking-wide hover:border-white/40 hover:text-white transition-all duration-200 w-full sm:w-auto"
        style="font-family: var(--font-sans);"
      >
        Ver tutorial
        <svg class="ml-2 w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

  </div>
</section>
