---
/* Layout raíz — estructura de página completa sin scroll, fuentes Google */
import "@/styles/global.css";
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>LogicRoutes — Rutas Inteligentes</title>

    <!-- Google Fonts: Bebas Neue (títulos) + Smooch Sans (contenido) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Smooch+Sans:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <!-- h-dvh: viewport dinámico que respeta UI del browser en móvil (iOS Safari) -->
  <body>
    <slot />
  </body>
</html>
